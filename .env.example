# Copy to .env if you want to override defaults. No secrets are required: the app calls no external APIs.
BIOAI_LOG_LEVEL=INFO
# tfidf (default, no extra packages) | dense (needs: pip install sentence-transformers; downloads all-MiniLM-L6-v2 from Hugging Face)
BIOAI_RETRIEVER=tfidf
# Opt-in, unauthenticated retraining endpoint (local demos only)
BIOAI_ENABLE_TRAIN_ENDPOINT=0
# BIOAI_MAX_BODY_BYTES=524288
# BIOAI_MODELS_DIR=
# BIOAI_DATA_DIR=
